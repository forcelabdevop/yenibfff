# Sunucu tarafi dagitim ayarlari
# ================================
# Bu dosyayi SUNUCUDA `deploy.env` adiyla kopyalayip degerleri doldurun.
# `deploy.env` git'e GIRMEZ (.gitignore) cunku yollar her makinede farklidir.
#
#   cp deploy.env.example deploy.env && nano deploy.env

# Hangi dal yayinlanacak
BRANCH=main

# Statik frontend'in sunuldugu dizin (nginx/apache root'u).
# aaPanel'de genelde: /www/wwwroot/<site-adi>
# BOS BIRAKIRSANIZ frontend yalnizca derlenir, yayinlanmaz.
WEB_ROOT=/www/wwwroot/velobet285.com

# Backend'in dinledigi port (backend/.env icindeki SERVER_PORT ile ayni olmali)
SERVER_PORT=5000

# Saglik kontrolu ucu — normalde degistirmeniz gerekmez
# HEALTH_URL=http://127.0.0.1:5000/health
# HEALTH_RETRIES=15
# HEALTH_DELAY=2

# aaPanel'de PATH cogu zaman eksiktir; script otomatik bulmaya calisir.
# Bulamazsa `which pnpm` / `which pm2` ciktisini buraya yazin:
# PNPM_BIN=/www/server/nodejs/v20.11.0/bin/pnpm
# PM2_BIN=/www/server/nodejs/v20.11.0/bin/pm2

# Dagitim logu
# LOG_FILE=/www/wwwroot/forcelab-repo/logs/deploy.log
