# Her saglayici, agent/operator paneli tarafindan verilen kendi
# kimlik bilgileriyle calisir. Gercek entegrasyonda bu degerler asla
# koda gomulmez (hardcode edilmez) — sadece ortam degiskeni olarak okunur.

PORT=4000

# ---- Betinovi (seamless wallet, POST + agent code/token body'de) ----
BETINOVI_API_ENDPOINT=https://api.example-betinovi.com/agent
BETINOVI_AGENT_CODE=demo_agent
BETINOVI_AGENT_TOKEN=demo_token

# ---- Drakon (OAuth Bearer token + GET query params) ----
DRAKON_BASE_URL=https://api.example-drakon.com
DRAKON_AGENT_CODE=demo_agent
DRAKON_AGENT_TOKEN=demo_token
DRAKON_CLIENT_ID=demo_client_id
DRAKON_CLIENT_SECRET=demo_client_secret

# ---- Nexus (seamless wallet, POST + agent code/token body'de) ----
NEXUS_BASE_URL=https://api.example-nexus.com/agent
NEXUS_AGENT_CODE=demo_agent
NEXUS_AGENT_TOKEN=demo_token

# ---- Poker (OAuth: Basic auth ile token al, sonra Bearer ile launch) ----
POKER_API_BASE_URL=https://api.example-poker.com
POKER_AGENT_TOKEN=demo_agent_token
POKER_AGENT_SECRET=demo_agent_secret

# ---- Betcolabs (sportsbook, session_token query-string ile iframe) ----
BETCOLABS_DESKTOP_URL=https://sports.example-betcolabs.com/desktop
BETCOLABS_MOBILE_URL=https://sports.example-betcolabs.com/mobile
BETCOLABS_AGENT_TOKEN=demo_agent_token
