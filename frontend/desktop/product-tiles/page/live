    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live</title>
    <link rel="stylesheet" href="/product-tiles/styles.css?v=7aa89e59">
</head>
<body>
    <div class="pb-item pb-live">
        <div class="pb-background">
            <img src="../assets/live/background.jpg" alt="">
        </div>
        <div class="pb-character">
            <img class="pb-character-img" src="../assets/live/character.png" alt="">
