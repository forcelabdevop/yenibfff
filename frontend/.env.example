# Static frontend'in doğrudan bağlanacağı Express backend adresi.
# NEXT_PUBLIC_* değerleri build sırasında frontend bundle'ına yazılır.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Site genelinde gösterilecek marka adı.
NEXT_PUBLIC_WEBSITE_NAME=Forcelab

# Deployment/proje kimliği. Frontend içinde gerektiğinde bu değer kullanılır.
NEXT_PUBLIC_PROJECT_ID=local

# Opsiyonel: verilmezse NEXT_PUBLIC_API_BASE_URL kullanılır.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Deployment ortamında WEBSITE_NAME, PROJECT_ID ve SERVER_BACKEND_URL adları da
# kabul edilir; next.config.mjs bunları yukarıdaki public değişkenlere aktarır.
