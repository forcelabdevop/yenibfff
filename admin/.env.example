# Panel genelinde gösterilecek marka adı ve proje kimliği.
VITE_WEBSITE_NAME=Forcelab
VITE_PROJECT_ID=local

# Tarayıcının bağlanacağı public backend adresi.
VITE_API_BASE_URL=http://localhost:5000

