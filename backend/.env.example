# Site/deployment kimliği
WEBSITE_NAME=Forcelab
PROJECT_ID=local

# Uygulamaların erişeceği public adresler
SERVER_BACKEND_URL=http://localhost:5000
SERVER_FRONTEND_URL=http://localhost:3000
SERVER_ADMIN_URL=http://localhost:5173

# MongoDB bağlantısı
DATABASE_URI=mongodb://127.0.0.1:27017/forcelab

# Yalnızca scripts/update-image-domains.js çalıştırılırken gerekir.
LEGACY_IMAGE_DOMAIN=old.example.com
IMAGE_BASE_URL=http://localhost:5000

# Provider import/test scriptleri
NEXUS_API_ENDPOINT=https://provider.example.com
NEXUS_AGENT_CODE=agent-code
NEXUS_AGENT_TOKEN=agent-token
NEXUS_AGENT_SECRET=agent-secret
TEST_USER_CODE=test-user
TEST_USER_TOKEN=test-user-token
TEST_GAME_CODE=test-game
